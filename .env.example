# HTTP server
ADDR=127.0.0.1:8088
# Container-only listen address. Override explicitly only when a non-loopback
# container listener is required.
CONTAINER_ADDR=127.0.0.1:8088
HTTP_PORT=8088
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=20m
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s

# Publication control-plane authentication. Leave empty to keep publication
# mutations disabled. Never commit a real token.
PUBLICATION_API_TOKEN=
# Comma-separated exact origins. Empty means same-origin/no cross-origin calls.
CORS_ALLOWED_ORIGINS=

# Application data directory
VIDEO_FACTORY_DATA_DIR=data
# Optional independent analytics SQLite path. Empty uses
# VIDEO_FACTORY_DATA_DIR/analytics/analytics.sqlite.
ANALYTICS_DB_PATH=

# Structured logging: debug, info, warn, or error
LOG_LEVEL=info

# Optional OpenAI-compatible research/judgment gateway. Base URL and model
# must be configured together. Leave both empty to keep the API available;
# parent pipeline runs then finish as capability_blocked.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_ALLOW_LOCAL=false
AI_GATEWAY_TIMEOUT=2m

# Optional media worker. Leave both required fields empty for API-only mode.
# MEDIA_WORKER_PYTHON=C:/Python312/python.exe
# MEDIA_WORKER_SCRIPT=tools/media-worker/media_worker.py
MEDIA_WORKER_PYTHON=
MEDIA_WORKER_SCRIPT=
MEDIA_WORKER_TIMEOUT=20m
MEDIA_WORKER_FFMPEG=
MEDIA_WORKER_FFPROBE=
MEDIA_WORKER_REMOTION=
# Use node.exe above with Remotion's JavaScript CLI entry when needed.
MEDIA_WORKER_REMOTION_CLI=
MEDIA_WORKER_REMOTION_CWD=
MEDIA_WORKER_REMOTION_ENTRY=
MEDIA_WORKER_REMOTION_COMPOSITION=
MEDIA_WORKER_EDGE_TTS_ROOT=

# Optional OpenMontage enhancement. The container does not include OpenMontage
# or its Node.js/Python/FFmpeg dependencies.
OPENMONTAGE_DIR=

# Optional publishing credentials. Keep empty locally and never commit secrets.
DOUYIN_ACCESS_TOKEN=
DOUYIN_OPEN_ID=
DOUYIN_METRICS_SCOPE=
DOUYIN_API_BASE_URL=
XHS_SHARE_APP_KEY=

# Optional Windows Ego Lite adapter. Leave empty until the local bridge and
# publisher script are installed. The service still starts with explicit
# not-configured publication capabilities.
EGO_NODE_PATH=
EGO_PUBLISHER_SCRIPT=
EGO_COMMAND=
# VIDEO_PUBLISHER_V2_EGO_COMMAND=tools/windows-browser-bridge/bin/ego-browser.exe
EGO_STATE_ROOT=
EGO_TIMEOUT=2m
EGO_ORIGINAL_RIGHTS_CONFIRMED=false
