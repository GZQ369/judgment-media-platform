# HTTP server
ADDR=127.0.0.1:8088
# Container-only listen address. Compose maps this to ADDR inside the container.
CONTAINER_ADDR=0.0.0.0:8088
HTTP_PORT=8088
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=20m
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s

# Application data directory
VIDEO_FACTORY_DATA_DIR=data

# Structured logging: debug, info, warn, or error
LOG_LEVEL=info

# Optional OpenMontage enhancement. The container does not include OpenMontage
# or its Node.js/Python/FFmpeg dependencies.
OPENMONTAGE_DIR=

# Optional publishing credentials. Keep empty locally and never commit secrets.
DOUYIN_ACCESS_TOKEN=
DOUYIN_OPEN_ID=
DOUYIN_API_BASE_URL=
XHS_SHARE_APP_KEY=
